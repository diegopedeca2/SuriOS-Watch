                <Condition><Expressions><Expression name="step_cell_4_ambient"><![CDATA[[STEP_COUNT] >= ([STEP_GOAL] * 4)]]></Expression></Expressions><Compare expression="step_cell_4_ambient"><PartDraw name="surios_step_cell_4_ambient" height="20" width="14" x="364" y="238"><RoundRectangle cornerRadiusX="4" cornerRadiusY="4" height="20" width="14" x="0" y="0"><Fill color="#FF06130C" /></RoundRectangle><RoundRectangle cornerRadiusX="4" cornerRadiusY="4" height="20" width="14" x="0" y="0"><Stroke color="#FF3FAF5A" thickness="1.5" /></RoundRectangle><RoundRectangle cornerRadiusX="2" cornerRadiusY="2" height="10" width="6" x="4" y="5"><Fill color="#FF3FAF5A" /></RoundRectangle><Line startX="3" startY="3" endX="11" endY="3"><Stroke color="#FF3FAF5A" thickness="1" /></Line><Line startX="3" startY="17" endX="11" endY="17"><Stroke color="#FF3FAF5A" thickness="1" /></Line></PartDraw></Compare></Condition>
                <Condition><Expressions><Expression name="step_cell_5_ambient"><![CDATA[[STEP_COUNT] >= ([STEP_GOAL] * 5)]]></Expression></Expressions><Compare expression="step_cell_5_ambient"><PartDraw name="surios_step_cell_5_ambient" height="20" width="14" x="381" y="238"><RoundRectangle cornerRadiusX="4" cornerRadiusY="4" height="20" width="14" x="0" y="0"><Fill color="#FF06130C" /></RoundRectangle><RoundRectangle cornerRadiusX="4" cornerRadiusY="4" height="20" width="14" x="0" y="0"><Stroke color="#FF3FAF5A" thickness="1.5" /></RoundRectangle><RoundRectangle cornerRadiusX="2" cornerRadiusY="2" height="10" width="6" x="4" y="5"><Fill color="#FF3FAF5A" /></RoundRectangle><Line startX="3" startY="3" endX="11" endY="3"><Stroke color="#FF3FAF5A" thickness="1" /></Line><Line startX="3" startY="17" endX="11" endY="17"><Stroke color="#FF3FAF5A" thickness="1" /></Line></PartDraw></Compare></Condition>
                <Condition><Expressions><Expression name="step_cells_plus_ambient"><![CDATA[[STEP_COUNT] > ([STEP_GOAL] * 5)]]></Expression></Expressions><Compare expression="step_cells_plus_ambient"><PartText name="surios_step_cells_plus_ambient" height="20" width="18" x="399" y="238"><Text align="CENTER"><Font color="#FF3FAF5A" family="SYNC_TO_DEVICE" size="18" weight="BOLD">+</Font></Text></PartText></Compare></Condition>
                </Group>
            </Group>
        </Group>
