<WatchFace
    height="450"
    width="450">

    <Metadata
        key="CLOCK_TYPE"
        value="DIGITAL" />

    <Scene>
        <PartDraw
            name="surios_background"
            height="450"
            width="450"
            x="0"
            y="0">
            <Rectangle
                height="450"
                width="450"
                x="0"
                y="0">
                <Fill color="#FF000000" />
            </Rectangle>
        </PartDraw>

        <PartImage
            name="surios_brotherhood_emblem"
            alpha="64"
            height="346"
            width="292"
            x="79"
            y="62">
            <Variant
                mode="AMBIENT"
                target="alpha"
                value="0" />
            <Image resource="brotherhood_emblem_pipgreen" />
        </PartImage>

        <Group
            name="surios_active"
            height="450"
            width="450"
            x="0"
            y="0">
            <Variant
                mode="AMBIENT"
                target="alpha"
                value="0" />

            <DigitalClock
                height="450"
                width="450"
                x="0"
                y="0">
                <TimeText
                    format="hh:mm"
                    hourFormat="24"
                    height="92"
                    width="340"
                    x="55"
                    y="42">
                    <Font
                        color="#FF66FF66"
                        family="SYNC_TO_DEVICE"
                        size="82" />
                </TimeText>
            </DigitalClock>

            <PartText
                name="surios_date"
                height="38"
                width="320"
                x="65"
                y="138">
                <Text>
                    <Font
                        color="#FF3FAF5A"
                        family="SYNC_TO_DEVICE"
                        size="28">
                        <Template>%s/%s/%s
                            <Parameter expression="[DAY_Z]" />
                            <Parameter expression="[MONTH_Z]" />
                            <Parameter expression="[YEAR]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <PartText
                name="surios_steps_active"
                height="40"
                width="88"
                x="61"
                y="205">
                <Text align="CENTER">
                    <Font
                        color="#FF66FF66"
                        family="SYNC_TO_DEVICE"
                        size="28">
                        <Template>%s
                            <Parameter expression="[STEP_COUNT] == 0 ? &quot;--&quot; : ([STEP_COUNT] &gt; 999999 ? &quot;999 999+&quot; : numberFormat(&quot;#,###&quot;, [STEP_COUNT]))" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <Condition>
                <Expressions>
                    <Expression name="active_battery_charging">[BATTERY_CHARGING_STATUS]</Expression>
                </Expressions>
                <Compare expression="active_battery_charging">
                    <PartText
                        name="surios_battery_recharging_active"
                        height="28"
                        width="106"
                        x="292"
                        y="207">
                        <Text align="CENTER">
                            <Font
                                color="#FF66FF66"
                                family="SYNC_TO_DEVICE"
                                size="15">RECHARGING</Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <Group
                        name="surios_battery_active"
                        height="450"
                        width="450"
                        x="0"
                        y="0">
                        <PartDraw
                            name="surios_battery_outline"
                            height="24"
                            width="63"
                            x="314"
                            y="191">
                            <Rectangle height="24" width="58" x="0" y="0">
                                <Stroke color="#FF66FF66" thickness="2" />
                            </Rectangle>
                            <Rectangle height="10" width="5" x="58" y="7">
                                <Fill color="#FF66FF66" />
                            </Rectangle>
                        </PartDraw>

                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_1"><![CDATA[[BATTERY_PERCENT] >= 1]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_1">
                                <PartDraw height="16" width="4" x="318" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_2"><![CDATA[[BATTERY_PERCENT] >= 11]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_2">
                                <PartDraw height="16" width="4" x="323" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_3"><![CDATA[[BATTERY_PERCENT] >= 21]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_3">
                                <PartDraw height="16" width="4" x="328" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_4"><![CDATA[[BATTERY_PERCENT] >= 31]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_4">
                                <PartDraw height="16" width="4" x="333" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_5"><![CDATA[[BATTERY_PERCENT] >= 41]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_5">
                                <PartDraw height="16" width="4" x="338" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_6"><![CDATA[[BATTERY_PERCENT] >= 51]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_6">
                                <PartDraw height="16" width="4" x="343" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_7"><![CDATA[[BATTERY_PERCENT] >= 61]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_7">
                                <PartDraw height="16" width="4" x="348" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_8"><![CDATA[[BATTERY_PERCENT] >= 71]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_8">
                                <PartDraw height="16" width="4" x="353" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_9"><![CDATA[[BATTERY_PERCENT] >= 81]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_9">
                                <PartDraw height="16" width="4" x="358" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>
                        <Condition>
                            <Expressions>
                                <Expression name="battery_level_10"><![CDATA[[BATTERY_PERCENT] >= 91]]></Expression>
                            </Expressions>
                            <Compare expression="battery_level_10">
                                <PartDraw height="16" width="4" x="363" y="195">
                                    <Rectangle height="16" width="4" x="0" y="0"><Fill color="#FF66FF66" /></Rectangle>
                                </PartDraw>
                            </Compare>
                        </Condition>

                        <PartText
                            name="surios_battery_percent_active"
                            height="32"
                            width="80"
                            x="305"
                            y="224">
                            <Text align="CENTER">
                                <Font
                                    color="#FF66FF66"
                                    family="SYNC_TO_DEVICE"
                                    size="24">
                                    <Template>%s%%
                                        <Parameter expression="[BATTERY_PERCENT]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Group>
                </Default>
            </Condition>

            <Group
                name="surios_fallout_access_labels_active"
                height="450"
                width="450"
                x="0"
                y="0">
                <PartDraw
                    name="surios_wallet_caps_outline"
                    height="30"
                    width="96"
                    x="57"
                    y="270">
                    <Rectangle height="30" width="96" x="0" y="0">
                        <Stroke color="#FF66FF66" thickness="1" />
                    </Rectangle>
                </PartDraw>

                <PartText
                    name="surios_wallet_caps"
                    height="30"
                    width="96"
                    x="57"
                    y="270">
                    <Text align="CENTER">
                        <Font
                            color="#FF66FF66"
                            family="SYNC_TO_DEVICE"
                            size="20">CAPS</Font>
                    </Text>
                    <Launch target="com.google.android.apps.walletnfcrel/com.google.commerce.tapandpay.wear.cardlist.WalletThemedWearCardListActivity" />
                </PartText>

                <PartDraw
                    name="surios_status_reference_outline"
                    height="30"
                    width="96"
                    x="177"
                    y="270">
                    <Rectangle height="30" width="96" x="0" y="0">
                        <Stroke color="#FF66FF66" thickness="1" />
                    </Rectangle>
                </PartDraw>

                <PartText
                    name="surios_status_reference"
                    height="30"
                    width="96"
                    x="177"
                    y="270">
                    <Text align="CENTER">
                        <Font
                            color="#FF66FF66"
                            family="SYNC_TO_DEVICE"
                            size="20">STATUS</Font>
                    </Text>
                    <Launch target="com.xiaomi.wear.fitness/com.xiaomi.wear.fitness.sport.component.vitality.SportVitalityActivity" />
                </PartText>

                <PartDraw
                    name="surios_spotify_radio_outline"
                    height="30"
                    width="96"
                    x="297"
                    y="270">
                    <Rectangle height="30" width="96" x="0" y="0">
                        <Stroke color="#FF66FF66" thickness="1" />
                    </Rectangle>
                </PartDraw>

                <PartText
                    name="surios_spotify_radio"
                    height="30"
                    width="96"
                    x="297"
                    y="270">
                    <Text align="CENTER">
                        <Font
                            color="#FF66FF66"
                            family="SYNC_TO_DEVICE"
                            size="20">RADIO</Font>
                    </Text>
                    <Launch target="com.spotify.music/com.spotify.wear.main.MainActivity" />
                </PartText>
            </Group>

            <Group
                name="surios_lower_text_active"
                height="450"
                width="450"
                x="0"
                y="0">
                <PartText
                    name="surios_lower_product"
                    height="38"
                    width="380"
                    x="35"
                    y="344">
                    <Text align="CENTER">
                        <Font
                            color="#FF3FAF5A"
                            family="SYNC_TO_DEVICE"
                            size="28">PIW-SuriOS</Font>
                    </Text>
                </PartText>

                <PartText
                    name="surios_lower_version"
                    height="38"
                    width="320"
                    x="65"
                    y="382">
                    <Text align="CENTER">
                        <Font
                            color="#FF3FAF5A"
                            family="SYNC_TO_DEVICE"
                            size="28">v2.0</Font>
                    </Text>
                </PartText>
            </Group>
        </Group>

        <Group
            name="surios_ambient"
            alpha="0"
            height="450"
            width="450"
            x="0"
            y="0">
            <Variant
                mode="AMBIENT"
                target="alpha"
                value="255" />

            <DigitalClock
                height="450"
                width="450"
                x="0"
                y="0">
                <TimeText
                    format="hh:mm"
                    hourFormat="24"
                    height="92"
                    width="340"
                    x="55"
                    y="42">
                    <Font
                        color="#FF66FF66"
                        family="SYNC_TO_DEVICE"
                        size="82" />
                </TimeText>
            </DigitalClock>

            <PartText
                name="surios_date_ambient"
                height="38"
                width="320"
                x="65"
                y="138">
                <Text>
                    <Font
                        color="#FF3FAF5A"
                        family="SYNC_TO_DEVICE"
                        size="28">
                        <Template>%s/%s/%s
                            <Parameter expression="[DAY_Z]" />
                            <Parameter expression="[MONTH_Z]" />
                            <Parameter expression="[YEAR]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <PartText
                name="surios_steps_ambient"
                height="40"
                width="88"
                x="61"
                y="205">
                <Text align="CENTER">
                    <Font
                        color="#FF3FAF5A"
                        family="SYNC_TO_DEVICE"
                        size="28">
                        <Template>%s
                            <Parameter expression="[STEP_COUNT] == 0 ? &quot;--&quot; : ([STEP_COUNT] &gt; 999999 ? &quot;999 999+&quot; : numberFormat(&quot;#,###&quot;, [STEP_COUNT]))" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <Condition>
                <Expressions>
                    <Expression name="ambient_battery_charging">[BATTERY_CHARGING_STATUS]</Expression>
                </Expressions>
                <Compare expression="ambient_battery_charging">
                    <PartText
                        name="surios_battery_recharging_ambient"
                        height="28"
                        width="106"
                        x="292"
                        y="207">
                        <Text align="CENTER">
                            <Font
                                color="#FF3FAF5A"
                                family="SYNC_TO_DEVICE"
                                size="15">RECHARGING</Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText
                        name="surios_battery_percent_ambient"
                        height="32"
                        width="80"
                        x="305"
                        y="224">
                        <Text align="CENTER">
                            <Font
                                color="#FF3FAF5A"
                                family="SYNC_TO_DEVICE"
                                size="24">
                                <Template>%s%%
                                    <Parameter expression="[BATTERY_PERCENT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>
    </Scene>
</WatchFace>
