<WatchFace
    height="450"
    width="450">

    <Metadata
        key="CLOCK_TYPE"
        value="DIGITAL" />

    <Scene>
        <PartDraw
            name="surios_background"
            height="450"
            width="450"
            x="0"
            y="0">
            <Rectangle
                height="450"
                width="450"
                x="0"
                y="0">
                <Fill color="#FF000000" />
            </Rectangle>
        </PartDraw>

        <DigitalClock
            height="450"
            width="450"
            x="0"
            y="0">
            <TimeText
                format="hh:mm"
                hourFormat="24"
                height="100"
                width="450"
                x="0"
                y="100">
                <Font
                    color="#FF66FF66"
                    family="SYNC_TO_DEVICE"
                    size="100" />
            </TimeText>
        </DigitalClock>

        <PartText
            name="surios_date"
            height="50"
            width="450"
            x="0"
            y="205">
            <Text>
                <Font
                    color="#FF3FAF5A"
                    family="SYNC_TO_DEVICE"
                    size="32">
                    <Template>%s/%s/%s
                        <Parameter expression="[DAY_Z]" />
                        <Parameter expression="[MONTH_Z]" />
                        <Parameter expression="[YEAR]" />
                    </Template>
                </Font>
            </Text>
        </PartText>
    </Scene>
</WatchFace>
